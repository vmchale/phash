module Main (main) where

import           PerceptualHash   (fileHash)
import           Test.Tasty
import           Test.Tasty.HUnit

tc fp0 fp1 = testCase ("match (" ++ fp0 ++ ", " ++ fp1 ++ ")") $ do
    h0 <- fileHash fp0; h1 <- fileHash fp1
    h0 @?= h1

main :: IO ()
main = defaultMain $ testGroup "unit"
    [ tc "demo-data/frog.jpeg" "demo-data/frog.png"
    , tc "demo-data/meme-watermark.jpg" "demo-data/meme.png"
    , testCase "not match" $ do {h0 <- fileHash "demo-data/cat.png"; h1 <- fileHash "demo-data/frog.png"; assertBool "detects difference" (h0/=h1)}
#ifdef AVIF
    , tc "demo-data/fashion.avif" "demo-data/fashion.png"
#endif
#ifdef WEBP
    , tc "demo-data/liz-taylor.webp" "demo-data/liz-taylor.png"
#endif
    ]
